<UserControl x:Class="SFallConfigurator.Controls.NumberBox"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root"
	Focusable="False"
	MinWidth="64">
	<UserControl.Resources>
		<Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Width" Value="18" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RepeatButton">
						<Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Margin="1">
							<TextBlock Text="{TemplateBinding Content}"
								FontFamily="{DynamicResource SymbolThemeFontFamily}"
								FontSize="9"
								Foreground="{TemplateBinding Foreground}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TextBox x:Name="Editor"
			Grid.ColumnSpan="2"
			Padding="6,2,20,2"
			TextAlignment="Right"
			VerticalContentAlignment="Center"
			PreviewTextInput="OnEditorPreviewTextInput"
			PreviewKeyDown="OnEditorPreviewKeyDown"
			LostFocus="OnEditorLostFocus"
			MouseWheel="OnEditorMouseWheel"
			DataObject.Pasting="OnEditorPasting" />

		<Grid Grid.Column="1" Margin="0,2,3,2">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<RepeatButton x:Name="IncreaseButton" Style="{StaticResource SpinButtonStyle}" Content="&#xE70E;" Click="OnIncreaseClick" />
			<RepeatButton x:Name="DecreaseButton" Grid.Row="1" Style="{StaticResource SpinButtonStyle}" Content="&#xE70D;" Click="OnDecreaseClick" />
		</Grid>
	</Grid>
</UserControl>