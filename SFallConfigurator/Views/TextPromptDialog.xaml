<Window
    x:Class="SFallConfigurator.Views.TextPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    Title="SFallConfigurator"
    Width="460"
    FocusManager.FocusedElement="{Binding ElementName=Input}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
	
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Prompt"
            Margin="0,0,0,8"
            TextWrapping="Wrap" />
        <TextBox x:Name="Input" Grid.Row="1" />

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Click="OnOkClick"
                Content="{loc:T 'OK'}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button
                Width="90"
                Margin="8,0,0,0"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
	
</Window>