<Window x:Class="SFallConfigurator.Views.TextPromptDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:loc="clr-namespace:SFallConfigurator.Localization"
	Title="SFallConfigurator"
	Width="460"
	SizeToContent="Height"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FocusManager.FocusedElement="{Binding ElementName=Input}">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
		<TextBox x:Name="Input" Grid.Row="1" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="{loc:T 'OK'}" Width="90" IsDefault="True" Click="OnOkClick" Style="{DynamicResource AccentButtonStyle}" />
			<Button Content="{loc:T 'Cancel'}" Width="90" IsCancel="True" Margin="8,0,0,0" />
		</StackPanel>
	</Grid>
</Window>