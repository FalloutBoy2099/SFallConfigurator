<Window
    x:Class="SFallConfigurator.Views.ItemPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    Title="SFallConfigurator"
    Width="520"
    Height="380"
    MinWidth="380"
    MinHeight="240"
    FontSize="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Prompt"
            Margin="0,0,0,8"
            TextWrapping="Wrap" />
        <ListBox
            x:Name="Items"
            Grid.Row="1"
            MouseDoubleClick="OnItemDoubleClick" />

        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Click="OnOkClick"
                Content="{loc:T 'OK'}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button
                Width="90"
                Margin="8,0,0,0"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>
