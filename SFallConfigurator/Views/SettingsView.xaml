<UserControl
    x:Class="SFallConfigurator.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization">

    <ScrollViewer
        Padding="0,0,8,0"
        Focusable="False"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,8,0,0">

            <Border
                Margin="0,0,0,6"
                Padding="10,6,10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="{loc:T 'Executable file of the game:'}" />
                    <ComboBox
                        Width="300"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Executables}"
                        SelectedItem="{Binding SelectedExecutable}"
                        ToolTip="{loc:T 'The file that starts the game.'}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,6"
                Padding="10,6,10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <ContentControl HorizontalAlignment="Left" Content="{Binding ConfigFile}" />
                    <Button
                        MinWidth="110"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenGameConfigCommand}"
                        Content="{loc:T 'Open Config'}"
                        ToolTip="{loc:T 'Opens the game configuration file.'}" />
                </StackPanel>
            </Border>

            <ItemsControl Focusable="False" ItemsSource="{Binding GameConfigGroups}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>