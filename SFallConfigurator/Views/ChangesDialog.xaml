<Window
    x:Class="SFallConfigurator.Views.ChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inf="clr-namespace:SFallConfigurator.Infrastructure;assembly=SFallConfigurator.Core"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    Title="{loc:T 'Changes to save'}"
    Width="640"
    Height="480"
    MinWidth="480"
    MinHeight="300"
    FontSize="12"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate DataType="{x:Type inf:ChangeRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,8,0"
                    Text="{Binding Name}"
                    TextWrapping="Wrap"
                    ToolTip="{Binding Location}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Before}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding After}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type inf:ChangeGroup}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{Binding FileName}" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:T 'Setting'}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:T 'Before'}" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:T 'After'}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Groups}" />
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:T 'There is no change to save.'}"
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="SaveButton"
                Width="90"
                Click="OnSaveClick"
                Content="{loc:T 'Save'}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button
                x:Name="CloseButton"
                Width="90"
                Margin="8,0,0,0"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>
