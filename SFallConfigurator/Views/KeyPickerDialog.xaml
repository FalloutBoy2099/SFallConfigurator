<Window x:Class="SFallConfigurator.Views.KeyPickerDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:loc="clr-namespace:SFallConfigurator.Localization"
	Title="{loc:T 'Select a key'}"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FocusManager.FocusedElement="{Binding ElementName=KeyList}">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock x:Name="Prompt" Text="{loc:T 'DirectInput key code (DIK_*):'}" Margin="0,0,0,8" />

		<ComboBox x:Name="KeyList"
			Grid.Row="1"
			Width="300"
			IsEditable="True"
			MaxDropDownHeight="320"
			FontFamily="Consolas"
			ToolTip="{loc:T 'Choose a key in the list, or type its code.'}" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="{loc:T 'Done'}" Width="90" IsDefault="True" Click="OnDoneClick" Style="{DynamicResource AccentButtonStyle}" />
			<Button Content="{loc:T 'Cancel'}" Width="90" IsCancel="True" Margin="8,0,0,0" />
		</StackPanel>
	</Grid>
</Window>