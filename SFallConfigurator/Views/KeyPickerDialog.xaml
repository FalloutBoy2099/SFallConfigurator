<Window
    x:Class="SFallConfigurator.Views.KeyPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    Title="{loc:T 'Select a key'}"
    FocusManager.FocusedElement="{Binding ElementName=KeyList}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Prompt"
            Margin="0,0,0,8"
            Text="{loc:T 'DirectInput key code (DIK_*):'}" />

        <ComboBox
            x:Name="KeyList"
            Grid.Row="1"
            Width="300"
            FontFamily="Consolas"
            IsEditable="True"
            MaxDropDownHeight="320"
            ToolTip="{loc:T 'Choose a key in the list, or type its code.'}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Click="OnDoneClick"
                Content="{loc:T 'Done'}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button
                Width="90"
                Margin="8,0,0,0"
                Content="{loc:T 'Cancel'}"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</Window>