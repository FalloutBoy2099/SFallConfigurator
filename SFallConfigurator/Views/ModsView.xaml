<UserControl
    x:Class="SFallConfigurator.Views.ModsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    xmlns:opt="clr-namespace:SFallConfigurator.Options;assembly=SFallConfigurator.ViewModels">

    <UserControl.Resources>
        <Style
            x:Key="GlyphButtonStyle"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!--  Load order  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{loc:T 'Ordered loading mods:'}" />
                <TextBlock
                    x:Name="HelpGlyph"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="&#xE897;"
                    ToolTip="{Binding Help}"
                    ToolTipService.ShowDuration="60000" />
            </StackPanel>
            <ListBox
                x:Name="OrderList"
                Grid.Row="1"
                AllowDrop="True"
                DragOver="OnOrderDragOver"
                Drop="OnOrderDrop"
                IsEnabled="{Binding OrderFileExists}"
                ItemsSource="{Binding Mods}"
                PreviewMouseLeftButtonDown="OnOrderPreviewMouseLeftButtonDown"
                PreviewMouseMove="OnOrderPreviewMouseMove"
                SelectedItem="{Binding SelectedMod}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            x:Name="Box"
                            IsChecked="{Binding CheckState}"
                            IsEnabled="{Binding IsMissing, Converter={StaticResource InverseBoolean}}"
                            ToolTipService.ShowOnDisabled="True">
                            <TextBlock Text="{Binding Name}" />
                        </CheckBox>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Box" Property="ToolTip" Value="{loc:T 'The file or the folder of this mod is missing.'}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!--  Buttons between the lists  -->
        <StackPanel
            Grid.Column="1"
            Margin="12,28,12,0"
            VerticalAlignment="Top">
            <Button
                AutomationProperties.Name="{loc:T 'Add the mod to the list.'}"
                Command="{Binding AddCommand}"
                Content="&#xE72B;"
                Style="{StaticResource GlyphButtonStyle}"
                ToolTip="{loc:T 'Add the mod to the list.'}" />
            <Button
                AutomationProperties.Name="{loc:T 'Move up.'}"
                Command="{Binding MoveUpCommand}"
                Content="&#xE74A;"
                Style="{StaticResource GlyphButtonStyle}"
                ToolTip="{loc:T 'Move up.'}" />
            <Button
                AutomationProperties.Name="{loc:T 'Move down.'}"
                Command="{Binding MoveDownCommand}"
                Content="&#xE74B;"
                Style="{StaticResource GlyphButtonStyle}"
                ToolTip="{loc:T 'Move down.'}" />
            <Button
                AutomationProperties.Name="{loc:T 'Remove the mod from the list.'}"
                Command="{Binding RemoveCommand}"
                Content="&#xE74D;"
                Style="{StaticResource GlyphButtonStyle}"
                ToolTip="{loc:T 'Remove the mod from the list.'}" />
        </StackPanel>

        <!--  Mods that load automatically  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,6"
                VerticalAlignment="Center"
                Text="{loc:T 'Autoloading mods:'}" />
            <ListBox
                Grid.Row="1"
                ItemsSource="{Binding AvailableMods}"
                SelectedItem="{Binding SelectedAvailableMod}" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,6,0,0"
            Orientation="Horizontal">
            <Button
                MinWidth="90"
                Command="{Binding CreateFileCommand}"
                Content="{loc:T 'Create File'}"
                ToolTip="{loc:T 'Creates mods_order.ini from the content of mods_order.txt'}"
                ToolTipService.ShowOnDisabled="True" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding OpenFileCommand}"
                Content="{loc:T 'Open File'}"
                ToolTip="{loc:T 'Opens mods_order.ini'}" />
            <ContentControl
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Content="{Binding DisableAutoloading}" />
        </StackPanel>
    </Grid>

</UserControl>