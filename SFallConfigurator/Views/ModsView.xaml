<UserControl x:Class="SFallConfigurator.Views.ModsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:loc="clr-namespace:SFallConfigurator.Localization"
	xmlns:opt="clr-namespace:SFallConfigurator.Options">
	<UserControl.Resources>
		<Style x:Key="GlyphButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="26" />
			<Setter Property="Margin" Value="0,0,0,8" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
			<Setter Property="FontSize" Value="14" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="220" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" MinWidth="200" />
		</Grid.ColumnDefinitions>

		<!-- Load order -->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<StackPanel Orientation="Horizontal" Margin="0,0,0,6">
				<TextBlock Text="{loc:T 'Ordered loading mods:'}" VerticalAlignment="Center" />
				<TextBlock x:Name="HelpGlyph"
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					FontFamily="{DynamicResource SymbolThemeFontFamily}"
					Text="&#xE897;"
					Foreground="{DynamicResource TextFillColorSecondaryBrush}"
					ToolTip="{Binding Help}"
					ToolTipService.ShowDuration="60000" />
			</StackPanel>
			<ListBox x:Name="OrderList"
				Grid.Row="1"
				ItemsSource="{Binding Mods}"
				SelectedItem="{Binding SelectedMod}"
				IsEnabled="{Binding OrderFileExists}"
				AllowDrop="True"
				PreviewMouseLeftButtonDown="OnOrderPreviewMouseLeftButtonDown"
				PreviewMouseMove="OnOrderPreviewMouseMove"
				DragOver="OnOrderDragOver"
				Drop="OnOrderDrop">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<CheckBox x:Name="Box"
							IsChecked="{Binding CheckState}"
							IsEnabled="{Binding IsMissing, Converter={StaticResource InverseBoolean}}"
							ToolTipService.ShowOnDisabled="True">
							<TextBlock Text="{Binding Name}" />
						</CheckBox>
						<DataTemplate.Triggers>
							<DataTrigger Binding="{Binding IsMissing}" Value="True">
								<Setter TargetName="Box" Property="ToolTip" Value="{loc:T 'The file or the folder of this mod is missing.'}" />
							</DataTrigger>
						</DataTemplate.Triggers>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<!-- Buttons between the lists -->
		<StackPanel Grid.Column="1" Margin="12,28,12,0" VerticalAlignment="Top">
			<Button Style="{StaticResource GlyphButtonStyle}"
				Content="&#xE72B;"
				Command="{Binding AddCommand}"
				ToolTip="{loc:T 'Add the mod to the list.'}" />
			<Button Style="{StaticResource GlyphButtonStyle}"
				Content="&#xE74A;"
				Command="{Binding MoveUpCommand}"
				ToolTip="{loc:T 'Move up.'}" />
			<Button Style="{StaticResource GlyphButtonStyle}"
				Content="&#xE74B;"
				Command="{Binding MoveDownCommand}"
				ToolTip="{loc:T 'Move down.'}" />
			<Button Style="{StaticResource GlyphButtonStyle}"
				Content="&#xE74D;"
				Command="{Binding RemoveCommand}"
				ToolTip="{loc:T 'Remove the mod from the list.'}" />
		</StackPanel>

		<!-- Mods that load automatically -->
		<Grid Grid.Column="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<TextBlock Text="{loc:T 'Autoloading mods:'}" Margin="0,0,0,6" VerticalAlignment="Center" />
			<ListBox Grid.Row="1"
				ItemsSource="{Binding AvailableMods}"
				SelectedItem="{Binding SelectedAvailableMod}" />
		</Grid>

		<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
			<Button Content="{loc:T 'Create File'}"
				MinWidth="90"
				Command="{Binding CreateFileCommand}"
				ToolTipService.ShowOnDisabled="True"
				ToolTip="{loc:T 'Creates mods_order.ini from the content of mods_order.txt'}" />
			<Button Content="{loc:T 'Open File'}"
				MinWidth="90"
				Margin="8,0,0,0"
				Command="{Binding OpenFileCommand}"
				ToolTip="{loc:T 'Opens mods_order.ini'}" />
			<ContentControl Margin="24,0,0,0"
				VerticalAlignment="Center"
				Content="{Binding DisableAutoloading}" />
		</StackPanel>
	</Grid>
</UserControl>