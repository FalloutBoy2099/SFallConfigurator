<UserControl
    x:Class="SFallConfigurator.Views.SfallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    DataContextChanged="OnDataContextChanged">
	
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl
            x:Name="Pages"
            ItemTemplate="{StaticResource PageHeaderTemplate}"
            ItemsSource="{Binding Pages}"
            SelectedIndex="0" />

        <StackPanel
            Grid.Row="1"
            Margin="0,6,0,0"
            Orientation="Horizontal">
            <Button
                MinWidth="90"
                Command="{Binding MergeCommand}"
                Content="{loc:T 'Merge config'}"
                ToolTip="{loc:T 'Applies the settings of another ini file to ddraw.ini.'}" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding MakeSfallIniCommand}"
                Content="{loc:T 'Make sfall.ini'}"
                ToolTip="{loc:T 'Creates the sfall.ini configuration file with the current ddraw.ini settings.'}"
                ToolTipService.ShowOnDisabled="True" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding OpenConfigCommand}"
                Content="{loc:T 'Open config'}"
                ToolTip="{loc:T 'Saves the current settings and opens the sFall configuration file.'}" />
            <Button
                MinWidth="90"
                Margin="8,0,0,0"
                Command="{Binding OpenModsIniCommand}"
                Content="sfall-mods.ini"
                ToolTip="{loc:T 'Saves the current settings and opens sfall-mods.ini.'}" />
        </StackPanel>
    </Grid>
	
</UserControl>