<UserControl x:Class="SFallConfigurator.Views.SfallView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:loc="clr-namespace:SFallConfigurator.Localization"
	DataContextChanged="OnDataContextChanged">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TabControl x:Name="Pages" ItemsSource="{Binding Pages}" SelectedIndex="0" ItemTemplate="{StaticResource PageHeaderTemplate}" />

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
			<Button Content="{loc:T 'Merge config'}"
				MinWidth="90"
				Command="{Binding MergeCommand}"
				ToolTip="{loc:T 'Applies the settings of another ini file to ddraw.ini.'}" />
			<Button Content="{loc:T 'Make sfall.ini'}"
				MinWidth="90"
				Margin="8,0,0,0"
				Command="{Binding MakeSfallIniCommand}"
				ToolTipService.ShowOnDisabled="True"
				ToolTip="{loc:T 'Creates the sfall.ini configuration file with the current ddraw.ini settings.'}" />
			<Button Content="{loc:T 'Open config'}"
				MinWidth="90"
				Margin="8,0,0,0"
				Command="{Binding OpenConfigCommand}"
				ToolTip="{loc:T 'Saves the current settings and opens the sFall configuration file.'}" />
			<Button Content="sfall-mods.ini"
				MinWidth="90"
				Margin="8,0,0,0"
				Command="{Binding OpenModsIniCommand}"
				ToolTip="{loc:T 'Saves the current settings and opens sfall-mods.ini.'}" />
		</StackPanel>
	</Grid>
</UserControl>