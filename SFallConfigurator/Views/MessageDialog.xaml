<Window x:Class="SFallConfigurator.Views.MessageDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="440"
	SizeToContent="Height"
	MinHeight="130"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontSize="12">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Margin="20,20,20,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="Glyph"
				Margin="0,0,16,0"
				VerticalAlignment="Top"
				FontFamily="{DynamicResource SymbolThemeFontFamily}"
				FontSize="28" />
			<TextBlock x:Name="Message"
				Grid.Column="1"
				VerticalAlignment="Center"
				TextWrapping="Wrap" />
		</Grid>

		<!-- The button bar uses the layer color of the theme, as the system message boxes do -->
		<Border Grid.Row="1"
			Padding="20,12"
			Background="{DynamicResource LayerFillColorDefaultBrush}">
			<StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
		</Border>
	</Grid>
</Window>