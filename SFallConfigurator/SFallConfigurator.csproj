<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>SFallConfigurator</AssemblyName>
		<ApplicationIcon>Resources\icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Product>SFallConfigurator</Product>
		<AssemblyTitle>SFallConfigurator</AssemblyTitle>
		<Copyright>Copyright © Mr.Stalin 2015 - 2026 + Kain 2026</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The built-in Fluent theme (ThemeMode) is flagged as experimental in the WPF reference assemblies. -->
		<NoWarn>$(NoWarn);WPF0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SFallConfigurator.ViewModels\SFallConfigurator.ViewModels.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SFallConfigurator.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\icon.ico" />
		<Resource Include="Resources\Black.png" />
		<Resource Include="Resources\Leather.png" />
		<Resource Include="Resources\Metal.png" />
	</ItemGroup>

</Project>