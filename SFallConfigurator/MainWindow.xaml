<Window
    x:Class="SFallConfigurator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:SFallConfigurator.Views"
    Title="{Binding Title}"
    Width="720"
    Height="650"
    MinWidth="540"
    MinHeight="480"
    Closing="OnClosing"
    ContentRendered="OnContentRendered"
    FontSize="12"
    Icon="pack://application:,,,/Resources/icon.ico"
    PreviewKeyDown="OnPreviewKeyDown"
    StateChanged="OnStateChanged">

    <Window.Resources>
        <!--  Compact versions of the Fluent controls: the original configurator was a small, dense window  -->
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0,0,0" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0,0,0" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="22" />
        </Style>

        <!--  Buttons of the title bar  -->
        <!--  An entry of a menu of the title bar: the check mark shows the current choice  -->
        <Style x:Key="ChoiceMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Command" Value="{Binding ChooseCommand}" />
            <Setter Property="Header" Value="{Binding Text}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter
                                x:Name="Glyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B22A1B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding Search.ShowCommand}"
            Modifiers="Control" />
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Frame">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar in the theme of the application  -->
        <Grid Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                Margin="10,0,8,0"
                Source="pack://application:,,,/Resources/icon.ico" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="{loc:T 'Search the options'}"
                    Command="{Binding Search.ToggleCommand}"
                    Content="&#xE721;"
                    FontSize="14"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="{loc:T 'Search the options (Ctrl+F)'}" />
                <Button
                    x:Name="ToolsButton"
                    AutomationProperties.Name="{loc:T 'Tools'}"
                    Click="OnMenuButtonClick"
                    Content="&#xE712;"
                    FontSize="14"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="{loc:T 'Tools'}">
                    <Button.ContextMenu>
                        <ContextMenu
                            x:Name="ToolsMenu"
                            FontFamily="Segoe UI"
                            FontSize="12">
                            <MenuItem Command="{Binding ReviewChangesCommand}" Header="{loc:T 'Review the changes...'}" />
                            <MenuItem
                                Header="{loc:T 'Review the changes before saving'}"
                                IsCheckable="True"
                                IsChecked="{Binding PreviewBeforeSaving, Mode=TwoWay}" />
                            <MenuItem
                                Header="{loc:T 'Read the files again when they change'}"
                                IsCheckable="True"
                                IsChecked="{Binding AutoReload, Mode=TwoWay}" />
                            <MenuItem Command="{Binding CheckInstallationCommand}" Header="{loc:T 'Check the installation...'}" />
                            <MenuItem Command="{Binding RestoreBackupCommand}" Header="{loc:T 'Restore a backup...'}" />
                            <Separator />
                            <MenuItem Command="{Binding Profiles.SaveCommand}" Header="{loc:T 'Save the settings as a profile...'}" />
                            <MenuItem
                                Header="{loc:T 'Apply a profile'}"
                                IsEnabled="{Binding Profiles.HasProfiles}"
                                ItemContainerStyle="{StaticResource ChoiceMenuItemStyle}"
                                ItemsSource="{Binding Profiles.ApplyChoices}" />
                            <MenuItem
                                Header="{loc:T 'Delete a profile'}"
                                IsEnabled="{Binding Profiles.HasProfiles}"
                                ItemContainerStyle="{StaticResource ChoiceMenuItemStyle}"
                                ItemsSource="{Binding Profiles.DeleteChoices}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button
                    x:Name="ThemeButton"
                    AutomationProperties.Name="{loc:T 'Theme'}"
                    Click="OnMenuButtonClick"
                    Content="&#xE790;"
                    FontSize="14"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="{loc:T 'Theme'}">
                    <Button.ContextMenu>
                        <ContextMenu
                            FontFamily="Segoe UI"
                            FontSize="12"
                            ItemContainerStyle="{StaticResource ChoiceMenuItemStyle}"
                            ItemsSource="{Binding ThemeChoices}" />
                    </Button.ContextMenu>
                </Button>
                <Button
                    x:Name="LanguageButton"
                    AutomationProperties.Name="{loc:T 'Language of the interface'}"
                    Click="OnMenuButtonClick"
                    Content="&#xE774;"
                    FontSize="14"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="{loc:T 'Language of the interface'}">
                    <Button.ContextMenu>
                        <ContextMenu
                            FontFamily="Segoe UI"
                            FontSize="12"
                            ItemContainerStyle="{StaticResource ChoiceMenuItemStyle}"
                            ItemsSource="{Binding LanguageChoices}" />
                    </Button.ContextMenu>
                </Button>
                <Button
                    AutomationProperties.Name="{loc:T 'Minimize'}"
                    Click="OnMinimizeClick"
                    Content="&#xE921;"
                    Style="{StaticResource CaptionButtonStyle}" />
                <Button
                    x:Name="MaximizeButton"
                    AutomationProperties.Name="{loc:T 'Maximize'}"
                    Click="OnMaximizeClick"
                    Content="&#xE922;"
                    Style="{StaticResource CaptionButtonStyle}" />
                <Button
                    AutomationProperties.Name="{loc:T 'Close'}"
                    Click="OnCloseClick"
                    Content="&#xE8BB;"
                    Style="{StaticResource CloseButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="8,6,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  The game folder the configurator works on  -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{loc:T 'Game folder:'}" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding RecentGameFolders}"
                    SelectedItem="{Binding SelectedGameFolder}"
                    ToolTip="{loc:T 'The folder that holds the game and the sFall configuration files. The last 10 game folders are remembered.'}" />
                <Button
                    Grid.Column="2"
                    MinWidth="40"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{loc:T 'Select the game folder.'}"
                    Command="{Binding ChooseGameFolderCommand}"
                    Content="&#xE838;"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    ToolTip="{loc:T 'Select the game folder.'}" />
            </Grid>

            <StackPanel Grid.Row="1">
                <!--  A notice: the files changed on disk, a backup was restored...  -->
                <Border
                    Margin="0,0,0,8"
                    Padding="10,6"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Notice}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Command="{Binding ReloadNowCommand}"
                            Content="{loc:T 'Read again'}"
                            Visibility="{Binding CanReloadNow, Converter={StaticResource BooleanToVisibility}}" />
                        <Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding DismissNoticeCommand}"
                            Content="{loc:T 'Dismiss'}" />
                    </Grid>
                </Border>

                <!--  Search of an option  -->
                <Grid
                    Margin="0,0,0,8"
                    IsVisibleChanged="OnSearchBarVisibleChanged"
                    Visibility="{Binding Search.IsVisible, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        AutomationProperties.Name="{loc:T 'Search the options'}"
                        PreviewKeyDown="OnSearchKeyDown"
                        Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{loc:T 'Search the options'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Search.OpenCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding Search.CloseCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorDisabledBrush}"
                        IsHitTestVisible="False"
                        Text="{loc:T 'Search the options'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox
                        x:Name="SearchResults"
                        Grid.Row="1"
                        MaxHeight="170"
                        Margin="0,4,0,0"
                        AutomationProperties.Name="{loc:T 'Search results'}"
                        ItemsSource="{Binding Search.Results}"
                        PreviewMouseLeftButtonUp="OnSearchResultClick"
                        SelectedItem="{Binding Search.SelectedResult}"
                        Visibility="{Binding Search.HasResults, Converter={StaticResource BooleanToVisibility}}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Search.OpenCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding Search.CloseCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Path}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Grid.Row="1"
                        Margin="8,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:T 'No option found.'}"
                        Visibility="{Binding Search.HasNoResult, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </StackPanel>

            <TabControl x:Name="MainTabs" Grid.Row="2">
                <TabItem
                    x:Name="SfallTab"
                    Header="{loc:T 'sFall Config'}"
                    Visibility="{Binding IsGameConfigured, Converter={StaticResource BooleanToVisibility}}">
                    <views:SfallView Margin="0,8,0,0" DataContext="{Binding Sfall}" />
                </TabItem>
                <TabItem
                    x:Name="HiResTab"
                    Header="{loc:T 'Hi-Res Config'}"
                    Visibility="{Binding IsGameConfigured, Converter={StaticResource BooleanToVisibility}}">
                    <views:HiResView Margin="0,8,0,0" DataContext="{Binding HiRes}" />
                </TabItem>
                <TabItem
                    x:Name="ModsTab"
                    Header="{loc:T 'Mods'}"
                    Visibility="{Binding IsGameConfigured, Converter={StaticResource BooleanToVisibility}}">
                    <views:ModsView Margin="0,8,0,0" DataContext="{Binding Mods}" />
                </TabItem>
                <TabItem
                    x:Name="SettingsTab"
                    Header="{loc:T 'Settings'}"
                    Visibility="{Binding IsGameConfigured, Converter={StaticResource BooleanToVisibility}}">
                    <views:SettingsView Margin="0,8,0,0" DataContext="{Binding Settings}" />
                </TabItem>
                <TabItem x:Name="DatInfoTab" Header="{loc:T 'Dat Info'}">
                    <views:DatInfoView Margin="0,8,0,0" DataContext="{Binding DatInfo}" />
                </TabItem>
            </TabControl>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    MinWidth="120"
                    Command="{Binding RunGameCommand}"
                    Content="{loc:T 'Run Game'}"
                    Style="{DynamicResource AccentButtonStyle}"
                    ToolTip="{Binding RunGameToolTip}"
                    ToolTipService.ShowOnDisabled="True" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsGameConfigured, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="{Binding Language.Label}" />
                    <ComboBox
                        Width="170"
                        IsEnabled="{Binding Language.IsEnabled}"
                        ItemsSource="{Binding Language.Suggestions}"
                        SelectedItem="{Binding Language.Text}"
                        ToolTip="{Binding Language.ToolTip}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    MinWidth="120"
                    Command="{Binding DoneCommand}"
                    Content="{loc:T 'Done'}"
                    ToolTip="{loc:T 'Save the settings and close.'}" />
            </Grid>
        </Grid>
    </Grid>

</Window>