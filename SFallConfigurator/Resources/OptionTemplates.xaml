<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:SFallConfigurator.Controls"
    xmlns:inf="clr-namespace:SFallConfigurator.Infrastructure"
    xmlns:loc="clr-namespace:SFallConfigurator.Localization"
    xmlns:opt="clr-namespace:SFallConfigurator.Options;assembly=SFallConfigurator.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:SFallConfigurator.ViewModels;assembly=SFallConfigurator.ViewModels">

    <!--  Converters  -->
    <inf:InverseBooleanConverter x:Key="InverseBoolean" />
    <inf:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <inf:RgbToBrushConverter x:Key="RgbToBrush" />

    <!--  Layout constants: an option occupies one column of the page, a wide one occupies two  -->
    <sys:Double x:Key="OptionWidth">280</sys:Double>
    <sys:Double x:Key="WideOptionWidth">584</sys:Double>
    <Thickness x:Key="OptionMargin">0,0,24,4</Thickness>

    <!--  Labels of options that were changed since the program started  -->
    <SolidColorBrush x:Key="ModifiedBrush" Color="#C71585" />

    <!--  Background of the option that a search showed  -->
    <SolidColorBrush x:Key="HighlightBrush" Color="#55FFC000" />

    <!--  The menu of an option: its history, its default value and the value that was saved  -->
    <ContextMenu x:Key="OptionMenu" FontSize="12">
        <MenuItem Command="{Binding UndoCommand}" Header="{loc:T 'Undo'}" />
        <MenuItem Command="{Binding RedoCommand}" Header="{loc:T 'Redo'}" />
        <Separator />
        <MenuItem
            Command="{Binding ResetCommand}"
            Header="{loc:T 'Reset to the default value'}"
            ToolTip="{Binding DefaultText}"
            Visibility="{Binding HasDefault, Converter={StaticResource BooleanToVisibility}}" />
        <MenuItem Command="{Binding RevertCommand}" Header="{loc:T 'Restore the saved value'}" />
        <Separator Visibility="{Binding CanAddKey, Converter={StaticResource BooleanToVisibility}}" />
        <MenuItem
            Command="{Binding AddKeyCommand}"
            Header="{loc:T 'Add the key to the file'}"
            Visibility="{Binding CanAddKey, Converter={StaticResource BooleanToVisibility}}" />
    </ContextMenu>

    <!--  Check box  -->
    <DataTemplate DataType="{x:Type opt:BoolOption}">
        <CheckBox
            x:Name="Box"
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            IsChecked="{Binding Value}"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
        </CheckBox>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Box" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Box" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Whole number: spin box or slider  -->
    <DataTemplate DataType="{x:Type opt:NumberOption}">
        <Grid
            x:Name="Layout"
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="Label"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="SliderValue"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding ValueText}"
                Visibility="Collapsed" />

            <!--  The color of a palette index: the button opens the colors of the game  -->
            <ToggleButton
                x:Name="ColorButton"
                Grid.Column="2"
                Width="32"
                Margin="6,0,0,0"
                Padding="0"
                AutomationProperties.Name="{Binding Label}"
                IsChecked="{Binding IsPaletteOpen, Mode=TwoWay}"
                IsEnabled="{Binding IsEnabled}"
                Visibility="Collapsed">
                <Border
                    Width="20"
                    Height="14"
                    Background="{Binding ColorRgb, Converter={StaticResource RgbToBrush}}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" />
            </ToggleButton>
            <Popup
                IsOpen="{Binding IsPaletteOpen, Mode=TwoWay}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=ColorButton}"
                StaysOpen="False">
                <Border
                    Padding="6"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ItemsControl Width="224" ItemsSource="{Binding PaletteEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="14"
                                    Height="14"
                                    MinHeight="0"
                                    Margin="0"
                                    Padding="0"
                                    Background="{Binding Rgb, Converter={StaticResource RgbToBrush}}"
                                    BorderThickness="0"
                                    Command="{Binding SelectCommand}"
                                    Focusable="False"
                                    ToolTip="{Binding Index}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <ctl:NumberBox
                x:Name="Spinner"
                Grid.Column="1"
                Width="84"
                AutomationProperties.Name="{Binding Label}"
                Increment="{Binding Increment, Mode=OneWay}"
                IsEnabled="{Binding IsEnabled}"
                Maximum="{Binding Maximum, Mode=OneWay}"
                Minimum="{Binding Minimum, Mode=OneWay}"
                Value="{Binding Value, Mode=TwoWay}" />

            <Grid
                x:Name="SliderPanel"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding MinimumLabel}" />
                <Slider
                    Grid.Column="1"
                    AutomationProperties.Name="{Binding Label}"
                    IsEnabled="{Binding IsEnabled}"
                    IsSnapToTickEnabled="True"
                    LargeChange="5"
                    Maximum="{Binding Maximum, Mode=OneWay}"
                    Minimum="{Binding Minimum, Mode=OneWay}"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Value, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding MaximumLabel}" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Presentation}" Value="Palette">
                <Setter TargetName="ColorButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Presentation}" Value="Slider">
                <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SliderValue" Property="Visibility" Value="Visible" />
                <Setter TargetName="SliderPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Setter TargetName="SliderValue" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  List of choices: drop-down list or radio buttons  -->
    <DataTemplate DataType="{x:Type opt:ChoiceOption}">
        <StackPanel
            x:Name="Layout"
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock
                x:Name="Label"
                Margin="0,0,0,2"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <ComboBox
                x:Name="DropDown"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding Label}"
                IsEnabled="{Binding IsEnabled}"
                ItemsSource="{Binding Items}"
                SelectedIndex="{Binding SelectedIndex}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Keyboard key  -->
    <DataTemplate DataType="{x:Type opt:KeyOption}">
        <Grid
            x:Name="Layout"
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox
                x:Name="Toggle"
                VerticalAlignment="Center"
                IsChecked="{Binding IsChecked}"
                IsEnabled="{Binding IsEnabled}">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock
                x:Name="PlainLabel"
                VerticalAlignment="Center"
                Text="{Binding Label}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Button
                Grid.Column="1"
                MinWidth="86"
                Margin="6,0,0,0"
                AutomationProperties.Name="{Binding Label}"
                Command="{Binding ChooseKeyCommand}"
                Content="{Binding CodeText}"
                IsEnabled="{Binding IsKeyEnabled}"
                ToolTip="{loc:T 'Assign another key.'}"
                ToolTipService.ShowOnDisabled="False" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasToggle}" Value="False">
                <Setter TargetName="Toggle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PlainLabel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Toggle" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Toggle" Property="FontStyle" Value="Italic" />
                <Setter TargetName="PlainLabel" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="PlainLabel" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="PlainLabel" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Text: a text box, or an editable drop-down list when there are suggestions; optional buttons  -->
    <DataTemplate DataType="{x:Type opt:TextOption}">
        <StackPanel
            x:Name="Layout"
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock
                x:Name="Label"
                Margin="0,0,0,2"
                Text="{Binding Label}"
                TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Plain"
                    AutomationProperties.Name="{Binding Label}"
                    IsEnabled="{Binding IsEnabled}"
                    IsReadOnly="{Binding IsReadOnly}"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
                <ComboBox
                    x:Name="Suggested"
                    AutomationProperties.Name="{Binding Label}"
                    IsEditable="True"
                    IsEnabled="{Binding IsEnabled}"
                    ItemsSource="{Binding Suggestions}"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    MinWidth="40"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{Binding ActionToolTip}"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionLabel}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding ActionToolTip}"
                    Visibility="{Binding ActionCommand, Converter={StaticResource NullToCollapsed}}" />
                <Button
                    Grid.Column="2"
                    MinWidth="40"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{Binding SecondaryActionToolTip}"
                    Command="{Binding SecondaryActionCommand}"
                    Content="{Binding SecondaryActionLabel}"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding SecondaryActionToolTip}"
                    Visibility="{Binding SecondaryActionCommand, Converter={StaticResource NullToCollapsed}}" />
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Suggestions}" Value="{x:Null}">
                <Setter TargetName="Suggested" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Path: a text box with one or two browse buttons, as wide as two options  -->
    <DataTemplate DataType="{x:Type opt:PathOption}">
        <StackPanel
            x:Name="Layout"
            Width="{StaticResource WideOptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock
                x:Name="Label"
                Margin="0,0,0,2"
                Text="{Binding Label}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="{Binding Label}"
                    IsEnabled="{Binding IsEnabled}"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    MinWidth="40"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{Binding ActionToolTip}"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionLabel}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding ActionToolTip}"
                    Visibility="{Binding ActionCommand, Converter={StaticResource NullToCollapsed}}" />
                <Button
                    Grid.Column="2"
                    MinWidth="40"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{Binding SecondaryActionToolTip}"
                    Command="{Binding SecondaryActionCommand}"
                    Content="{Binding SecondaryActionLabel}"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding SecondaryActionToolTip}"
                    Visibility="{Binding SecondaryActionCommand, Converter={StaticResource NullToCollapsed}}" />
            </Grid>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Side panel picture of the Hi-Res interface bar  -->
    <DataTemplate DataType="{x:Type opt:BarArtOption}">
        <Grid
            x:Name="Layout"
            Width="{StaticResource WideOptionWidth}"
            Margin="{StaticResource OptionMargin}"
            ContextMenu="{StaticResource OptionMenu}"
            ContextMenuService.ShowOnDisabled="True"
            ToolTip="{Binding HelpText}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    x:Name="Label"
                    Margin="0,0,0,2"
                    Text="{Binding Label}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding Label}"
                    IsEnabled="{Binding IsEnabled}"
                    ItemsSource="{Binding Presets}"
                    SelectedIndex="{Binding PresetIndex}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button
                        Width="40"
                        AutomationProperties.Name="{loc:T 'Previous'}"
                        Command="{Binding DecrementCommand}"
                        Content="&lt;" />
                    <TextBlock
                        Width="48"
                        VerticalAlignment="Center"
                        Text="{Binding Art}"
                        TextAlignment="Center" />
                    <Button
                        Width="40"
                        AutomationProperties.Name="{loc:T 'Next'}"
                        Command="{Binding IncrementCommand}"
                        Content="&gt;" />
                </StackPanel>
            </StackPanel>
            <Border
                Grid.Column="1"
                Margin="16,0,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="4">
                <Image
                    Width="150"
                    Height="87"
                    Source="{Binding PreviewImage}"
                    Stretch="Fill" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ModifiedBrush}" />
                <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Layout" Property="Background" Value="{StaticResource HighlightBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Screen resolution of sfall  -->
    <DataTemplate DataType="{x:Type vm:SfallResolutionEditor}">
        <Grid Width="{StaticResource WideOptionWidth}" Margin="{StaticResource OptionMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ctl:NumberBox
                        Width="84"
                        AutomationProperties.Name="{loc:T 'Width'}"
                        Increment="{Binding Width.Increment, Mode=OneWay}"
                        IsEnabled="{Binding Width.IsEnabled}"
                        Maximum="{Binding Width.Maximum, Mode=OneWay}"
                        Minimum="{Binding Width.Minimum, Mode=OneWay}"
                        ToolTip="{loc:T 'Width'}"
                        Value="{Binding Width.Value, Mode=TwoWay}" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="X" />
                    <ctl:NumberBox
                        Width="84"
                        AutomationProperties.Name="{loc:T 'Height'}"
                        Increment="{Binding Height.Increment, Mode=OneWay}"
                        IsEnabled="{Binding Height.IsEnabled}"
                        Maximum="{Binding Height.Maximum, Mode=OneWay}"
                        Minimum="{Binding Height.Minimum, Mode=OneWay}"
                        ToolTip="{loc:T 'Height'}"
                        Value="{Binding Height.Value, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox
                    Margin="0,8,0,0"
                    Content="{loc:T 'Also set the resolution of the Hi-Res patch'}"
                    IsChecked="{Binding SetHiResResolution}"
                    IsEnabled="{Binding IsHiResAvailable}"
                    ToolTip="{loc:T 'Also set the chosen resolution in the Hi-Res patch settings.'}" />
                <CheckBox
                    Content="{loc:T 'Scaling X2 (sFall &amp; HRP)'}"
                    IsChecked="{Binding ScaleX2}"
                    IsEnabled="{Binding IsScaleAvailable}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource ModifiedBrush}"
                    Text="{Binding Hint}"
                    TextWrapping="Wrap"
                    Visibility="{Binding NeedsResolution, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Margin="0,0,0,2" Text="{loc:T 'Available resolutions:'}" />
                <ListBox
                    Height="150"
                    ItemsSource="{Binding Resolutions.Items}"
                    SelectedItem="{Binding Resolutions.Selected}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  Screen resolution of the Hi-Res patch  -->
    <DataTemplate DataType="{x:Type vm:HiResResolutionEditor}">
        <Grid Width="{StaticResource WideOptionWidth}" Margin="{StaticResource OptionMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ctl:NumberBox
                        Width="84"
                        AutomationProperties.Name="{loc:T 'Width'}"
                        Increment="{Binding Width.Increment, Mode=OneWay}"
                        IsEnabled="{Binding Width.IsEnabled}"
                        Maximum="{Binding Width.Maximum, Mode=OneWay}"
                        Minimum="{Binding Width.Minimum, Mode=OneWay}"
                        ToolTip="{loc:T 'Width'}"
                        Value="{Binding Width.Value, Mode=TwoWay}" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Text="X" />
                    <ctl:NumberBox
                        Width="84"
                        AutomationProperties.Name="{loc:T 'Height'}"
                        Increment="{Binding Height.Increment, Mode=OneWay}"
                        IsEnabled="{Binding Height.IsEnabled}"
                        Maximum="{Binding Height.Maximum, Mode=OneWay}"
                        Minimum="{Binding Height.Minimum, Mode=OneWay}"
                        ToolTip="{loc:T 'Height'}"
                        Value="{Binding Height.Value, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox
                    Margin="0,8,0,0"
                    IsChecked="{Binding ScaleX2.Value}"
                    IsEnabled="{Binding ScaleX2.IsEnabled}">
                    <TextBlock Text="{Binding ScaleX2.Label}" />
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock
                    Margin="0,0,0,4"
                    Text="{loc:T 'Available resolutions:'}"
                    ToolTip="{loc:T 'Resolutions available on this system.'}" />
                <ListBox
                    Height="150"
                    ItemsSource="{Binding Resolutions.Items}"
                    SelectedItem="{Binding Resolutions.Selected}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  Paragraph of explanation  -->
    <DataTemplate DataType="{x:Type opt:OptionNote}">
        <TextBlock
            Width="{StaticResource WideOptionWidth}"
            Margin="{StaticResource OptionMargin}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Text}"
            TextWrapping="Wrap" />
    </DataTemplate>

    <!--  Read-only text with a button  -->
    <DataTemplate DataType="{x:Type vm:FileDisplayItem}">
        <StackPanel Width="{StaticResource WideOptionWidth}" Margin="{StaticResource OptionMargin}">
            <TextBlock Margin="0,0,0,2" Text="{Binding Label}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="{Binding Label}"
                    IsReadOnly="True"
                    Text="{Binding Text, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    MinWidth="40"
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{Binding ToolTip}"
                    Command="{Binding ActionCommand}"
                    Content="{Binding ActionLabel}"
                    ToolTip="{Binding ToolTip}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!--  Button  -->
    <DataTemplate DataType="{x:Type vm:CommandItem}">
        <Button
            Margin="{StaticResource OptionMargin}"
            HorizontalAlignment="Left"
            Command="{Binding Command}"
            Content="{Binding Label}"
            ToolTip="{Binding ToolTip}" />
    </DataTemplate>

    <!--  Check box applied by a handler  -->
    <DataTemplate DataType="{x:Type vm:ToggleItem}">
        <CheckBox
            Width="{StaticResource OptionWidth}"
            Margin="{StaticResource OptionMargin}"
            IsChecked="{Binding IsChecked}"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="{Binding ToolTip}"
            ToolTipService.ShowDuration="60000"
            ToolTipService.ShowOnDisabled="True">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
        </CheckBox>
    </DataTemplate>

    <!--  Options one under the other, in the space of one option  -->
    <DataTemplate DataType="{x:Type opt:OptionColumn}">
        <ItemsControl Focusable="False" ItemsSource="{Binding Items}" />
    </DataTemplate>

    <!--  A titled card of options  -->
    <DataTemplate DataType="{x:Type opt:OptionGroup}">
        <Border
            Margin="0,0,0,6"
            Padding="10,6,0,1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  A page of cards  -->
    <DataTemplate DataType="{x:Type vm:OptionPage}">
        <ScrollViewer
            Padding="0,0,8,0"
            Focusable="False"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                Margin="1,6,0,0"
                Focusable="False"
                ItemsSource="{Binding Groups}" />
        </ScrollViewer>
    </DataTemplate>

    <!--  Tab header of a page  -->
    <DataTemplate x:Key="PageHeaderTemplate">
        <TextBlock Text="{Binding Header}" />
    </DataTemplate>
</ResourceDictionary>