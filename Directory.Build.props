<Project>

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<RootNamespace>SFallConfigurator</RootNamespace>
		<Version>2026.10.12.1</Version>
		<AssemblyVersion>2026.10.12.1</AssemblyVersion>
		<FileVersion>2026.10.12.1</FileVersion>
		<InformationalVersion>2026.10.12.1</InformationalVersion>
	</PropertyGroup>

</Project>
