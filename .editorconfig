root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
indent_style = tab
indent_size = 4
tab_width = 4

[*.cs]
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_using_directive_placement = inside_namespace:warning
dotnet_style_predefined_type_for_locals_parameters_members = false:warning
dotnet_style_predefined_type_for_member_access = false:warning
dotnet_diagnostic.IDE0049.severity = warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# Rules of the analyzers that do not fit this program.
# The members that the user interface binds to are instance members even when they use no field.
dotnet_diagnostic.CA1822.severity = none
# The types of the fields and of the returns stay the interfaces of the services: tests replace them.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1845.severity = suggestion
dotnet_diagnostic.CA1861.severity = suggestion

[*.xaml]
indent_style = space
indent_size = 4

[*.{json,ps1}]
end_of_line = lf
